sort=-time
layer=overlay
width=300
height=110
border-size=2
border-radius=15
icons=1
max-icon-size=64
icon-path=/usr/share/icons/Papirus-Dark/
default-timeout=5000
ignore-timeout=0
font=CaskaydiaCove Nerd Font 12

# Colors
background-color=#282828
text-color=#EBDBB2
border-color=#8EC07C
progress-color=#B16286

[urgency=low]
border-color=#83A598

[urgency=normal]
border-color=#FE8019

[urgency=high]
border-color=#FB4934
ignore-timeout=1

[category=mpd]
default-timeout=2000
group-by=category
