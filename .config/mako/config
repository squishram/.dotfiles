sort=-time
layer=overlay
width=300
height=110
border-size=2
border-radius=15
icons=1
max-icon-size=64
icon-path=/usr/share/icons/Papirus-Dark/
default-timeout=5000
ignore-timeout=0
font=CaskaydiaCove Nerd Font 12

# Colors
background-color=#303446
text-color=#c6d0f5
border-color=#8caaee
progress-color=#414559

[urgency=low]
border-color=#cccccc

[urgency=normal]
border-color=#d08770

[urgency=high]
border-color=#ef9f76
ignore-timeout=1

[category=mpd]
default-timeout=2000
group-by=category
