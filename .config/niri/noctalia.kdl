layout {

    focus-ring {
        active-color   "#4dd9e6"
        inactive-color "#101414"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#4dd9e6"
        inactive-color "#101414"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#4dd9e6"
        inactive-color "#004f55"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#4dd9e680"
    }
}

recent-windows {
    highlight {
        active-color "#4dd9e6"
        urgent-color "#ffb4ab"
    }
}
