{
  // --- POSITION --- //
  // layer
  "layer": "top",
  // position (top|bottom|left|right)
  "position": "top",
  // height (remove for auto height)
  "height": 50,
  // width (remove for auto width)
  // "width": 1080,
  // gaps between modules (px)
  "spacing": 3,
  // --- MODULES --- //
  // --- LEFT --- //
  "modules-left": [
    // "custom/spotify",
    "niri/window"
  ],
  // --- CENTRE --- //
  "modules-center": [
    "niri/workspaces"
  ],
  // --- RIGHT --- //
  "modules-right": [
    "pulseaudio",
    "battery",
    "cpu",
    "memory",
    "network",
    "clock"
  ],
  "niri/window": {
    "format": "{}",
    "separate-outputs": true,
    "icon": true,
    "icon-size": 16,
    "rewrite": {
      "(.*) — LibreOffice Writer": "$1",
      "(.*) — LibreOffice Base": "$1",
      "(.*) — LibreOffice Draw": "$1",
      "(.*) — LibreOffice Impress": "$1",
      "(.*) — LibreOffice Math": "$1",
      "(.*) — Mozilla Firefox": "$1",
      "(.*) — Zen Browser": "$1",
      "(.*) — Zen Browser Private Browsing": "$1 (Private)",
      "(.*) - Mozilla Thunderbird": "󰇮 $1",
      "(.*) - Thunderbird": "󰇮 $1",
      "(.*) — LibreWolf": "$1",
      "(.*) — LibreWolf Private Browsing": "$1",
    }
  },
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "focused": "",
      "active": "",
      "default": "◦"
    }
  },
  "keyboard-state": {
    "numlock": true,
    "capslock": true,
    "format": "{name} {icon}",
    "format-icons": {
      "locked": "",
      "unlocked": ""
    }
  },
  // "tray": {
  //   "icon-size": 21,
  //   "spacing": 10
  // },
  "clock": {
    "format": " {:%H:%M}",
    "format-alt": " {:%A %d %B %Y (%R)}",
    "tooltip-format": "<tt><big>{calendar}</big></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#99d1db'><b>{}</b></span>",
        "days": "<span color='#f4b8e4'><b>{}</b></span>",
        "weeks": "<span color='#a6d189'><b>W{}</b></span>",
        "weekdays": "<span color='#e5c890'><b>{}</b></span>",
        "today": "<span color='#e78284'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode"
    }
  },
  "cpu": {
    "format": "{usage}% <span color='#ef9f76'></span>",
    "tooltip": false
  },
  "memory": {
    "format": "{}% <span color='#e5c890'></span>"
  },
  "temperature": {
    // "thermal-zone": 2,
    // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 80,
    // "format-critical": "{temperatureC}°C {icon}",
    "format": "{temperatureC}°C {icon}",
    "format-icons": [
      "",
      "",
      ""
    ]
  },
  "network": {
    // "interface": "wlp2*", // (Optional) To force the use of this interface
    "format-wifi": "{essid} <span color='#a6d189'>{signalStrength}% </span>",
    "format-ethernet": "<span color='#a6d189'>󰢾</span>",
    "tooltip-format": "{ifname} via {gwaddr} ",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "<span color='#e78284'>󰢿</span>",
    // "on-click": "nm-connection-editor"
    "format-alt": "{ifname}: {ipaddr}/{cidr}"
  },
  "pulseaudio": {
    "scroll-step": 3, // %, can be a float
    "format": "<span color='#99d1db'>{icon}</span> {volume}%",
    "format-muted": "󰖁 {volume}%",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  // "custom/updates": {
  //   "format": "{} {icon}",
  //   "return-type": "json",
  //   "format-icons": {
  //     "has-updates": "󱍷",
  //     "updated": "󰂪"
  //   },
  //   "exec-if": "which waybar-module-pacman-updates",
  //   "exec": "waybar-module-pacman-updates"
  // },
  "battery": {
    "bat": "BAT1",
    "interval": 60,
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "{capacity}% <span color='#a6d189'>{icon}</span>",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "max-length": 25
  },
  "custom/spotify": {
    "exec": "/usr/bin/python3 $HOME/.config/waybar/mediaplayer.py",
    "format": "{}",
    "return-type": "json",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "group/hardware": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "memory"
    ]
  }
}
